pkgname=cockpit-security-dashboard
pkgver=VERSION
pkgrel=1
pkgdesc='Cockpit Security Monitoring and Management Dashboard'
arch=('x86_64')
url='https://github.com/xinti/cockpit-security-dashboard'
license=(LGPL)
source=("SOURCE")
sha256sums=('SKIP')

package() {
  depends=(cockpit)
  cd $pkgname
  make DESTDIR="$pkgdir" install PREFIX=/usr
}
